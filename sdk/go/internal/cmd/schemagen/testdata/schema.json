      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/Cell"
          },
          "type": "array"
        }
      ]
    },
    "Confidence": {
      "description": "How sure.",
