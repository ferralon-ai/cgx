    "CalleesInput": {
      "properties": {
        "confidence": {
          "enum": [
            "certain",
            "probable",
            "possible"
          ],
          "type": "string"
        },
        "depth": {
          "default": 3,
          "type": "integer"
        },
        "include_dirty": {
          "default": true,
          "type": "boolean"
        },
        "kind": {
          "items": {
            "enum": [
              "calls",
              "calls_virtual"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "root": {
          "type": "string"
        },
        "symbol": {
          "description": "Qualified symbol name",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "root"
      ],
      "type": "object"
    },
