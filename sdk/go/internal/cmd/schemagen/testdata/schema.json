        },
        "confidence": {
          "$ref": "#/$defs/Confidence",
          "description": "Edge confidence."
        },
        "count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "depth": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "name": {
